<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AddonManager.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="AddonManager.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Loon Best in Slot Addon Manager">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto" Margin="10">
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5"
					HorizontalAlignment="Right">
            <Button Command="{Binding NavigateImporterCommand}" Content="Importer" />
            <Button Command="{Binding NavigateGuideCommand}" Content="Guide" />
        </StackPanel>

        <TransitioningContentControl Content="{Binding CurrentPage}" />
    </Grid>
</Window>
